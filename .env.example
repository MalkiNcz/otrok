# ==========================================================
#  OTROK BOT - konfigurace prostředí
#  Zkopíruj tento soubor jako ".env" a doplň vlastní hodnoty.
# ==========================================================

# --- Discord aplikace (https://discord.com/developers/applications) ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Volitelné: ID serveru pro rychlé (okamžité) nasazení slash příkazů
# jen na jeden server během vývoje. Nech prázdné pro globální registraci.
DEV_GUILD_ID=

# ID účtu/účtů (oddělené čárkou), které mají přístup do dashboardu
# i bez role "Manage Server" na žádném serveru (bot owner / superadmin).
BOT_OWNER_IDS=

# --- Databáze (sdílený SQLite soubor mezi botem a dashboardem) ---
DATABASE_PATH=./data/otrok.db

# --- Webový dashboard ---
DASHBOARD_PORT=3000
# Veřejná URL, na které dashboard poběží (musí odpovídat Redirect URI
# nastavenému v Discord Developer Portal, s příponou /auth/callback)
DASHBOARD_BASE_URL=http://localhost:3000
# Náhodný dlouhý řetězec pro podepisování session cookie (vygeneruj např.
# příkazem: openssl rand -hex 32)
SESSION_SECRET=

# --- Logování ---
LOG_LEVEL=info
